# Container image (for pulling prebuilt image or set local GITHUB_REPO=user/repo)
# GITHUB_REPO=denri1994/scansnap-home-docker

# Host directory where ScanSnap Home stores scanned documents (mapped to C:\ScanSnapHome)
SCANS_DIR=./scans

# Optional: IP address of your Wi-Fi ScanSnap scanner (warms ARP entry before startup)
SCANNER_IP=192.168.1.50

# Automatically restart ScanSnap Home inside the container if closed/crashed (1 = enabled)
KEEP_APP_RUNNING=1

# Web UI (noVNC over NGINX) and VNC ports (using network_mode: host)
WEB_LISTENING_PORT=6080
VNC_LISTENING_PORT=5999
VNC_LOCALHOST_ONLY=1

# Virtual display size & UI theme (0 = light, 1 = dark)
DISPLAY_WIDTH=1440
DISPLAY_HEIGHT=900
DARK_MODE=0
WEB_HOST_CLIPBOARD_SYNC=1

# Comma-separated OCR packs from the offline installer (e.g. 1,6 | all | none)
# 1 = Americas & Europe (DE/EN/FR/IT/ES/PT/RU)
OCR_LANGS=1,6

# Optional: direct download URL if you don't manually place WinSSHOfflineInstaller_*.exe in ./installer/
SCANSNAP_INSTALLER_URL=

# Locale & timezone
TZ=Europe/Berlin
LANG=de_DE.UTF-8
LC_ALL=de_DE.UTF-8
USER_ID=1000
GROUP_ID=1000

# Optional: Password protection (uncomment one or both and forward in docker-compose.yml)
# Option 1 - Classic VNC password (prompts inside noVNC & VNC clients, max 8 chars evaluated):
# VNC_PASSWORD=your-password
#
# Option 2 - NGINX web login page (/login/) with session cookie & arbitrary password length:
# WEB_AUTHENTICATION=1
# WEB_AUTHENTICATION_USERNAME=admin
# WEB_AUTHENTICATION_PASSWORD=your-long-secure-password
# WEB_AUTHENTICATION_ALLOW_INSECURE=1
